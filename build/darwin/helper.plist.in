<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd daemon definition for the privileged helper, registered through
  SMAppService.daemonServiceWithPlistName:.

  BundleProgram is relative to the .app bundle, which is what lets
  SMAppService verify that the daemon it is being asked to install really is
  part of this application. The app and the helper must carry the same Team ID
  or registration fails silently — check with:

      launchctl print system/com.sr3d.diskspacesaver.helper

  @TEAM_ID@ is substituted by the Makefile.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sr3d.diskspacesaver.helper</string>

    <key>BundleProgram</key>
    <string>Contents/MacOS/diskspacesaver-helper</string>

    <key>ProgramArguments</key>
    <array>
        <string>Contents/MacOS/diskspacesaver-helper</string>
        <string>-bundle</string>
        <string>com.sr3d.diskspacesaver</string>
        <string>-team</string>
        <string>@TEAM_ID@</string>
        <!-- Exit when idle; launchd starts it again on the next connection,
             so root is not sitting resident between scans. -->
        <string>-idle</string>
        <string>10m</string>
    </array>

    <key>Sockets</key>
    <dict>
        <key>Helper</key>
        <dict>
            <key>SockPathName</key>
            <string>/var/run/com.sr3d.diskspacesaver.helper.sock</string>
            <!-- 0666: any local process can connect, and the code-signature
                 check on each connection is what actually restricts callers.
                 File permissions cannot express "only this application". -->
            <key>SockPathMode</key>
            <integer>438</integer>
            <key>SockFamily</key>
            <string>Unix</string>
            <key>SockType</key>
            <string>stream</string>
        </dict>
    </dict>

    <!-- Makes Login Items show this as part of DiskSpaceSaver rather than as
         an anonymous background item. -->
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.sr3d.diskspacesaver</string>
    </array>

    <key>KeepAlive</key>
    <false/>
    <key>RunAtLoad</key>
    <false/>
    <key>ProcessType</key>
    <string>Adaptive</string>
    <key>StandardErrorPath</key>
    <string>/var/log/diskspacesaver-helper.log</string>
</dict>
</plist>
